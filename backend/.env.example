# Railway sets PORT automatically. Server listens on 0.0.0.0.
PORT=8080
# Mainnet only. Any other value aborts boot.
NETWORK=mainnet-beta
# Helius mainnet RPC (falls back to https://api.mainnet-beta.solana.com)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Must equal the "Authorization header" configured on the Helius webhook
HELIUS_WEBHOOK_SECRET=change-me
PROGRAM_ID=6f54qVP1zv9F36A5Cxj9ogzm5DSVY1pQFndZWTwcVL8
COMPANY_WALLET=3aeVzSa3XKR8vstMFkXzVCnokcC4LApQPH3S8G7ckLgm
# Comma separated. https://*.vercel.app is always allowed in addition.
CORS_ORIGINS=https://www.stovia.xyz,https://stovia.xyz,http://localhost:3100
# Optional. Postgres (Railway plugin provides it). Unset = in-memory store.
DATABASE_URL=
# Optional
RATE_LIMIT_MAX=300
LOG_LEVEL=info
