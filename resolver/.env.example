# --- Secrets (set in Railway variables; NEVER commit real values) ---
# 32-byte hex master seed. Every market's shielded identity is derived from it (HKDF).
# Generate: openssl rand -hex 32. Losing it = losing all unpaid stakes. Leaking it = theft.
RESOLVER_MASTER_SEED=
# NOTE: there is NO Solana signer secret. Every Solana tx is built UNSIGNED with fee payer =
# the company wallet (= Config.resolver on-chain) and signed in the browser via the admin API.
# Helius API key (mainnet RPC + /v1/spr indexer + TEE prover).
HELIUS_API_KEY=

# --- Storage ---
# Postgres URL. Empty = in-memory (dev only: claims are lost on restart).
DATABASE_URL=

# --- Behaviour ---
# Create admin actions (unsigned post_sealed_results / payout / sweep txs for the company wallet to sign).
# Default false = dry run (compute results only, no actions).
RESOLVER_SEND_ENABLED=false
WORKER_INTERVAL_MS=30000
CORS_ORIGIN=*
PORT=8080
LOG_LEVEL=info

# --- Optional overrides ---
# SOLANA_RPC_URL=            # defaults to https://mainnet.helius-rpc.com/?api-key=$HELIUS_API_KEY
# COMPANY_WALLET=3aeVzSa3XKR8vstMFkXzVCnokcC4LApQPH3S8G7ckLgm   # fee payer, Config.resolver, treasury, admin auth key
# STOVIA_PROGRAM_ID=6f54qVP1zv9F36A5Cxj9ogzm5DSVY1pQFndZWTwcVL8
# STOVIA_IDL_PATH=./idl/stovia.json
# SEALED_BET_SEED=sealed_bet
# RPC_MAX_TX_VERSION=1       # maxSupportedTransactionVersion for getTransaction (SPR builders emit v1 txs)
